{
  "name": "opengantt-bim",
  "version": "0.2.7",
  "description": "Open-source desktop Gantt, line of balance and 4D BIM (IFC) scheduling",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run copy:wasm && electron-vite dev",
    "build": "npm run copy:wasm && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "npm run copy:wasm && vite --config vite.web.config.mts",
    "fetch:mongod": "node scripts/fetch-mongod.mjs",
    "fetch:mpp": "node scripts/fetch-mpp-runtime.mjs",
    "dist": "node node_modules/electron/install.js && npm run fetch:mongod && npm run fetch:mpp && npm run build && electron-builder",
    "dist:dir": "node node_modules/electron/install.js && npm run fetch:mongod && npm run fetch:mpp && npm run build && electron-builder --dir",
    "copy:wasm": "node scripts/copy-wasm.mjs"
  },
  "keywords": [],
  "author": "Gabriel Jordan",
  "repository": {
    "type": "git",
    "url": "https://github.com/gjordanp/opengantt-bim.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@thatopen/components": "3.6.0",
    "@thatopen/fragments": "3.6.0",
    "camera-controls": "3.1.2",
    "dhtmlx-gantt": "10.0.3",
    "dockview-react": "8.8.3",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^1.70.0",
    "mongodb": "7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "mongodb-memory-server-core": "11.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "private": true
}
